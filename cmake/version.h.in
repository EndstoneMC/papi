#pragma once

#include <string_view>

namespace papi {

/**
 * @brief The version of Endstone PAPI that this build provides.
 *
 * Generated from cmake/version.h.in by CMake; @PROJECT_VERSION@ is substituted
 * at configure time so the value is baked into the header as a compile-time
 * constant. This keeps getVersion() header-only and linkable from any
 * translation unit that includes the public header.
 */
inline constexpr std::string_view kVersion = "@PROJECT_VERSION@";

[[nodiscard]] inline std::string_view getVersion() noexcept
{
    return kVersion;
}

}  // namespace papi
